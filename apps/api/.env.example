# ============ LLM（最后填写 key，填入后自动切换真实模式）============
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# ============ Web 搜索（最后填写 key，为空走模拟数据）============
TAVILY_API_KEY=

# ============ 向量/精排模型（本地目录，绝不落 C 盘）============
HF_HOME=../../models
HF_ENDPOINT=https://hf-mirror.com
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# ============ 数据库 ============
DATABASE_URL=sqlite+aiosqlite:///./kra.db

# ============ 向量库（企业知识库 RAG，docker compose up -d qdrant）============
QDRANT_URL=http://localhost:6333

# ============ 知识库检索（混合检索：bge-m3 dense+sparse 双路 RRF）============
KB_MIN_SCORE=0.45
KB_SPARSE_MIN_WEIGHT=0.5
HYBRID_SEARCH=true

# ============ 查询增强（提问前 LLM 改写+关键词扩展）============
QUERY_PROCESSING=true

# ============ 重排（RRF 融合后 bge-reranker-v2-m3 模型精排）============
RERANK_ENABLED=true

# ============ PDF 智能解析（类型分流 + 版面还原 + 图片 OCR）============
PDF_OCR_ENABLED=true
PDF_OCR_MIN_CHARS=50
PDF_MARGIN_TOP=0.05
PDF_MARGIN_BOTTOM=0.95

# ============ 上传限制 ============
MAX_UPLOAD_MB=100

# ============ VLM 图表多模态理解（OpenAI 兼容，mimo-v2.5；Key 留空自动关闭）============
VLM_API_KEY=
VLM_BASE_URL=https://api.xiaomimimo.com/v1
VLM_MODEL=mimo-v2.5

# ============ 服务 ============
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173
